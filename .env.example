# Docker Compose settings (copy to .env). Application settings live in
# backend/.env and frontend/.env.local.

# Host ports (bound to 127.0.0.1)
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_FORWARD_PORT=5432

# PostgreSQL
POSTGRES_DB=krl
POSTGRES_USER=krl
POSTGRES_PASSWORD=secret

# Run containers as your WSL user so generated files (vendor, node_modules) stay editable. Check with `id`.
UID=1000
GID=1000

# --- Custom local domains (optional) -----------------------------------------
# Requires a reverse proxy on the Windows host (e.g. Caddy with `tls internal`):
#   my-krl.local     -> 127.0.0.1:${FRONTEND_PORT}
#   api.my-krl.local -> 127.0.0.1:${BACKEND_PORT}
# and hosts entries: 127.0.0.1 my-krl.local api.my-krl.local
# Leave these commented out to use http://localhost:<port> instead.
#APP_DOMAIN=my-krl.local
#FRONTEND_URL=https://my-krl.local
#API_URL=https://api.my-krl.local
#SANCTUM_STATEFUL_DOMAINS=my-krl.local
## Leading dot: the session/XSRF cookies are shared by my-krl.local and api.my-krl.local
#SESSION_DOMAIN=.my-krl.local
#SESSION_SECURE_COOKIE=true
