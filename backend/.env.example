APP_NAME="KRL Schedule"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Next.js origin (used for CORS and Sanctum stateful cookies)
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=krl
DB_USERNAME=krl
DB_PASSWORD=secret

# Session cookie: HTTP-only, SameSite=Lax. Set SESSION_SECURE_COOKIE=true in production (HTTPS).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Initial admin account created by the seeder (change for any shared environment!)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@krl.test
ADMIN_PASSWORD=Admin12345

# Station list for the monthly station sync (admins can change it in Admin -> Stasiun).
# Empty = take the station list from the KCI client below (http or mock).
KCI_STATIONS_API_URL=https://www.kci.id/api/krl/stations
KCI_STATIONS_API_TOKEN=

# Timetable of one station for the daily schedule sync. "stationid" (or {station}) is replaced
# per synced station. Empty = use the KCI client below (http or mock).
KCI_SCHEDULES_API_URL="https://www.kci.id/api/krl/schedules?stationid=THB&timefrom=00%3A00&timeto=23%3A00"
KCI_SCHEDULES_API_TOKEN=

# Stops of one train ("trainid" or {train} replaced per train), synced with URL-based schedules.
# Enables "Ke stasiun" (destination station) search. Empty = disabled.
KCI_TRAIN_STOPS_API_URL="https://www.kci.id/api/krl/train-schedule?trainid=5701C"
KCI_TRAIN_STOPS_API_TOKEN=
KCI_TRAIN_STOPS_CONCURRENCY=5

# KCI integration. Leave KCI_API_URL empty to use the bundled mock data source.
KCI_DRIVER=auto
KCI_API_URL=
KCI_API_KEY=
KCI_STATIONS_ENDPOINT=/krl-station
KCI_SCHEDULES_ENDPOINT=/schedule
KCI_TIMEOUT=20
KCI_RETRIES=2
KCI_REQUEST_DELAY_MS=200
# Comma-separated station codes to sync, e.g. THB while testing. Empty = all stations.
KCI_SYNC_STATIONS=
KCI_SYNC_DAYS=7
KCI_RETENTION_DAYS=7
KCI_SYNC_TIME=02:00
# Station list is refreshed monthly (day of month, time)
KCI_STATION_SYNC_DAY=1
KCI_STATION_SYNC_TIME=01:00
