APP_NAME="My KRL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Next.js origin (used for CORS and Sanctum stateful cookies)
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=krl
DB_USERNAME=krl
DB_PASSWORD=secret

# Session cookie: HTTP-only, SameSite=Lax. Set SESSION_SECURE_COOKIE=true in production (HTTPS).
SESSION_DRIVER=database
# Minutes. 525600 = 1 year: users and admins stay signed in (the cookie is renewed on every visit)
SESSION_LIFETIME=525600
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Initial admin account created by the seeder (change for any shared environment!)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@krl.test
ADMIN_PASSWORD=Admin12345

# Data comes from krl-sync on Vercel; this server never fetches from KCI itself.
# Ingest API for krl-sync: the same secret as INGEST_TOKEN there. Empty = API off.
SYNC_INGEST_TOKEN=
# krl-sync endpoint for a train's stops on demand (opened train detail). Empty = off.
KCI_STOPS_PROXY_URL=https://krl-sync.vercel.app/api/sync
# Default stations krl-sync syncs until an admin chooses them. Empty = all stations.
KCI_SYNC_STATIONS=

# Demo data for the seeder. Leave KCI_API_URL empty to use the bundled mock data source.
KCI_DRIVER=auto
KCI_API_URL=
KCI_API_KEY=
KCI_STATIONS_ENDPOINT=/krl-station
KCI_SCHEDULES_ENDPOINT=/schedule
KCI_TIMEOUT=20
KCI_RETRIES=2
